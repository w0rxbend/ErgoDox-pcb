/*
 * SPDX-License-Identifier: GPL-2.0-or-later
 *
 * Default ErgoDox keymap. Key positions and keycodes are translated from the
 * ZSA QMK ergodox_ez default keymap (firmware25, LAYOUT_ergodox_pretty),
 * which is GPL-2.0-or-later. This is not a copy of that C file.
 *
 * VRSN has no ZMK string, so it is &none. EE_CLR is &none and is not bootloader.
 * QK_BOOT is &bootloader (RST_UF2). LED_LEVEL is &rgb_ug RGB_BRI because this
 * board has SK6812 underglow rather than the three ErgoDox EZ LEDs.
 * TT(SYMB) is &tog 1. ALL_T(KC_NO) and MEH_T(KC_NO) are the hold-only macros
 * hyper and meh. RGB_M_P has no ZMK mode select; RGB_COLOR_HSB(0, 0, 10) is a
 * stand-in for solid white at the 10% cap, not a verified QMK equivalent.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>
                , <&macro_pause_for_release>
                , <&macro_release &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>
                ;
        };

        meh: meh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT &kp LALT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LCTRL &kp LSHFT &kp LALT>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp EQUAL &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp LEFT
                &kp RIGHT &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
                &kp DEL &kp Q &kp W &kp E &kp R &kp T &tog 1
                &tog 1 &kp Y &kp U &kp I &kp O &kp P &kp BSLH
                &kp BSPC &kp A &kp S &kp D &kp F &kp G
                &kp H &kp J &kp K &kp L &lt 2 SEMI &mt LGUI SQT
                &kp LSHFT &mt LCTRL Z &kp X &kp C &kp V &kp B &hyper
                &meh &kp N &kp M &kp COMMA &kp DOT &mt LCTRL FSLH &kp RSHFT
                &lt 1 GRAVE &kp SQT &kp LA(LSHFT) &kp LEFT &kp RIGHT
                &kp UP &kp DOWN &kp LBKT &rgb_ug RGB_BRI &tog 1
                &mt LALT K_APP &kp LGUI
                &kp LALT &mt LCTRL ESC
                &kp HOME
                &kp PG_UP
                &kp SPACE &kp BSPC &kp END
                &kp PG_DN &kp TAB &kp ENTER
            >;
        };

        symbol_layer {
            display-name = "Symbol";
            bindings = <
                &none &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &trans
                &trans &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
                &trans &kp EXCL &kp AT &kp LBRC &kp RBRC &kp PIPE &trans
                &trans &kp UP &kp N7 &kp N8 &kp N9 &kp STAR &kp F12
                &trans &kp HASH &kp DOLLAR &kp LPAR &kp RPAR &kp GRAVE
                &kp DOWN &kp N4 &kp N5 &kp N6 &kp PLUS &trans
                &bootloader &kp PERCENT &kp CARET &kp LBKT &kp RBKT &kp TILDE &trans
                &trans &kp AMPS &kp N1 &kp N2 &kp N3 &kp BSLH &trans
                &none &trans &trans &trans &trans
                &trans &kp DOT &kp N0 &trans &trans
                &rgb_ug RGB_EFF &trans
                &rgb_ug RGB_TOG &rgb_ug RGB_COLOR_HSB(0, 0, 10)
                &trans
                &trans
                &rgb_ug RGB_BRD &rgb_ug RGB_BRI &trans
                &trans &rgb_ug RGB_HUD &rgb_ug RGB_HUI
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &mmv MOVE_UP &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans
                &trans &trans &trans &trans &trans &kp C_PLAY_PAUSE
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &kp C_PREV &kp C_NEXT &trans &trans
                &trans &trans &trans &mkp MB1 &mkp MB2
                &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE &trans &trans
                &trans &trans
                &trans &trans
                &trans
                &trans
                &trans &trans &trans
                &trans &trans &kp C_AC_BACK
            >;
        };
    };
};
