/*
 * Copyright (c) 2026 The ErgoDox RP2040 contributors
 * SPDX-License-Identifier: MIT
 *
 * Shared by all four images. Left and right differ only in column order
 * and the LINK power hogs. UART pins live in the RP2040 board overlay so
 * this file does not claim GPIO0 or GPIO1 a second time.
 *
 * Columns are the outputs. They idle high and the scanned column is driven
 * low. Rows are inputs with pull-ups, so a press reads low. Diode cathodes
 * face the columns. That is col2row with GPIO_ACTIVE_LOW, which is the
 * opposite flag polarity of the ZMK kscan example.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
        zmk,ext-power = &ext_power;
    };

    wired_split: wired_split {
        compatible = "zmk,wired-split";
        device = <&uart0>;
    };

    /*
     * LED_ON is GPIO3, active high, with a board pulldown. Not a role hog:
     * both images use the same external-power switch, and underglow turns it
     * on only while RGB is on (CONFIG_ZMK_RGB_UNDERGLOW_ON_START=n).
     */
    ext_power: ext_power {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "ErgoDox";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    /*
     * Global matrix is 6 rows by 14 columns. ZMK row 0 is the top number row
     * (schematic ROW5). ZMK row 5 is the thumb row (schematic ROW0).
     * RC(row, col) follows LAYOUT_ergodox_pretty argument order, with QMK's
     * transposed matrix: QMK's column index is this row, and QMK's row index
     * is this global column. Empty crossings ROW0/COL0 and ROW3/COL6 are
     * omitted.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <6>;
        columns = <14>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)
            RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)
            RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
            RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)
            RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
            RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
            RC(5,5) RC(5,6) RC(5,7) RC(5,8) RC(5,4) RC(5,9)
            RC(5,3) RC(5,2) RC(5,1) RC(5,12) RC(5,11) RC(5,10)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };
};

/*
 * 1 Mbaud is a project choice. ZMK does not document a wired-split baud.
 * Both images use this node. Pinctrl stays on the Pico uart0_default,
 * restated in the board overlay (TX P0, RX P1, input-enable, no sleep state).
 */
&uart0 {
    status = "okay";
    current-speed = <1000000>;
};

/*
 * GPIO19 is the left/right strap: left is pulled to GND, right to +3V3.
 * No internal bias. This hog does not select the ZMK role or the side.
 * The flashed image does. SPI0 is disabled so it cannot claim this pin.
 */
&gpio0 {
    board_id: board_id {
        gpio-hog;
        gpios = <19 GPIO_ACTIVE_HIGH>;
        input;
    };
};
