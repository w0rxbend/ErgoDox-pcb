	(text "RIGHT half. Silkscreen this board RIGHT."
		(at 40 12 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "1fca21b4-935b-4094-8731-e3f913b57798")
	)
	(text "LINK receptacle silkscreen: LINK and NOT A PC PORT. It is not a USB device port."
		(at 40 15.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "a985b5f1-8518-4f3c-916c-2b62c4328100")
	)
	(text "UART swap on this half: D+ = LINK_RX, D- = LINK_TX. GPIO0 is UART0 TX. GPIO1 is UART0 RX."
		(at 40 19 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "56085c6a-0091-4c6e-8b20-b86e78a09044")
	)
	(text "Board id: GPIO19 10k to +3V3. Firmware may read it. It does not select the ZMK role."
		(at 40 22.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "3f625763-994b-495d-ae1e-b4c8e6cc0c7d")
	)
	(text "ZMK role is compile-time. Flash the central image into the half whose HOST plug is in the computer."
		(at 40 26 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "2836e0b6-faba-47c7-b8d6-6f0d8476d578")
	)
	(text "HOST CC pins are Rd 5.1k only. No Rp on HOST. VBUS enters +5V through SS14."
		(at 40 29.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "128bc645-6881-47a2-b7c0-eaebfb64ca16")
	)
	(text "LINK Rp is 36k to +3.3V, one per CC pin, only while LINK_RP_EN is high."
		(at 40 33 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "6cc12330-c478-49aa-810f-115c0c5ff7f3")
	)
	(text "CC divider 200k/100k keeps a 36k open pin at 2.95 V and 5.5 V at 1.83 V on the ADC."
		(at 40 36.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "37a5575b-661d-42af-b4e2-cb8a46f3b02b")
	)
	(text "VBUS divider 100k/100k maps 5.5 V to 2.75 V. Divider LCSC codes are blank."
		(at 40 40 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "994e163d-15a1-4e88-bc8e-936c42457709")
	)
	(text "JFET, Rp MOSFET, and both gate MOSFETs have no verified MPN or LCSC."
		(at 40 43.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "8497cc11-4b6e-4b90-919f-0c2b56fefd67")
	)
	(text "USB_DP and USB_DM are the HOST pair between the ESD device side and the 27 ohm resistors."
		(at 40 47 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "addd07f5-f135-4558-8577-ae6f2782ebb0")
	)
	(text "USB D+/D- on the board is 0.290661 mm wide with 0.203200 mm edge gap (DESIGN.md section 13)."
		(at 40 50.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "d97aa693-4151-456d-a412-09c56a5bb4f5")
	)
	(text "No level shifter on the SK6812 data pin. Direct 3.3 V drive is not guaranteed."
		(at 40 54 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "a709fc04-be30-4c52-ab51-d05327685d37")
	)
	(text "Firmware LED cap is 10 percent of full-scale white, both halves together."
		(at 40 57.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "903f3d41-cf1b-4240-a45e-83f501681c75")
	)
