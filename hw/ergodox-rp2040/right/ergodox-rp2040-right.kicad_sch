	(text "RIGHT half. Silkscreen this board RIGHT."
		(at 40 12 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "a442db1d-7168-4cef-bd4a-f953fceadb94")
	)
	(text "LINK receptacle silkscreen: LINK and NOT A PC PORT. It is not a USB device port."
		(at 40 15.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "80a8c59a-4296-41bc-b667-7064b12de19b")
	)
	(text "UART swap on this half: D+ = LINK_RX, D- = LINK_TX. GPIO0 is UART0 TX. GPIO1 is UART0 RX."
		(at 40 19 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "fc1a6f8b-e4fe-417f-9756-a46066a2f7e6")
	)
	(text "Board id: GPIO19 10k to +3V3. Firmware may read it. It does not select the ZMK role."
		(at 40 22.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "6c14493b-db6d-44da-b03d-d336ddcbb78a")
	)
	(text "ZMK role is compile-time. Flash the central image into the half whose HOST plug is in the computer."
		(at 40 26 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "3af07123-d132-485d-9ce3-5d41ad2ce279")
	)
	(text "HOST CC pins are Rd 5.1k only. No Rp on HOST. VBUS enters +5V through SS14."
		(at 40 29.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "54badad4-97b5-4ce0-a5fc-7baac680efb5")
	)
	(text "LINK Rp is 36k to +3.3V, one per CC pin, only while LINK_RP_EN is high."
		(at 40 33 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "46b69805-cf8d-4082-bf18-80d1d9156d95")
	)
	(text "CC divider 200k/100k keeps a 36k open pin at 2.95 V and 5.5 V at 1.83 V on the ADC."
		(at 40 36.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "caf774d0-602f-4022-b095-426aaa3a4d0a")
	)
	(text "VBUS divider 100k/100k maps 5.5 V to 2.75 V. Divider LCSC codes are blank."
		(at 40 40 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "b1abe8ce-b903-4ba8-aecb-1df49dd9b827")
	)
	(text "36k, 100k and 200k resistors have no verified LCSC code."
		(at 40 43.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "a9b92147-60fc-44a6-9ac8-44417693cea8")
	)
	(text "USB_DP and USB_DM are the HOST pair between the ESD device side and the 27 ohm resistors."
		(at 40 47 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "12628448-f723-43de-bf6d-da58c86fa890")
	)
	(text "USB D+/D- on the board is 0.290661 mm wide with 0.203200 mm edge gap (DESIGN.md section 13)."
		(at 40 50.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "a4265e65-cb2a-4e2b-b635-b5752568eb88")
	)
	(text "No level shifter on the SK6812 data pin. Direct 3.3 V drive is not guaranteed."
		(at 40 54 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "aa92b3cc-669f-4e4c-8b00-3703812c410b")
	)
	(text "Firmware LED cap is 10 percent of full-scale white, both halves together."
		(at 40 57.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "5a98afea-5002-4482-8b58-407fdaaae791")
	)
