	(text "LEFT half. Silkscreen this board LEFT."
		(at 40 12 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "1eb1a552-3fd1-4f95-9a1e-976f2cf3c77f")
	)
	(text "LINK receptacle silkscreen: LINK and NOT A PC PORT. It is not a USB device port."
		(at 40 15.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "edcba918-0038-482c-80ea-bca5a58da860")
	)
	(text "UART swap on this half: D+ = LINK_TX, D- = LINK_RX. GPIO0 is UART0 TX. GPIO1 is UART0 RX."
		(at 40 19 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "71552b76-058b-403f-96b4-1a6f382c9087")
	)
	(text "Board id: GPIO19 10k to GND. Firmware may read it. It does not select the ZMK role."
		(at 40 22.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "6729b036-08f1-46a4-adb4-2a34c39dd99a")
	)
	(text "ZMK role is compile-time. Flash the central image into the half whose HOST plug is in the computer."
		(at 40 26 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "4887cdda-c83a-47f0-9913-e893318ee661")
	)
	(text "HOST CC pins are Rd 5.1k only. No Rp on HOST. VBUS enters +5V through SS14."
		(at 40 29.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "4a63b728-ea73-4ca3-a02a-ca13550e7a62")
	)
	(text "LINK Rp is 36k to +3.3V, one per CC pin, only while LINK_RP_EN is high."
		(at 40 33 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "39ac2a58-319f-4c18-b0ed-b94feb74c78b")
	)
	(text "CC divider 200k/100k keeps a 36k open pin at 2.95 V and 5.5 V at 1.83 V on the ADC."
		(at 40 36.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "6ba3af6e-53ea-45a2-a298-da3f51f93c9f")
	)
	(text "VBUS divider 100k/100k maps 5.5 V to 2.75 V. Divider LCSC codes are blank."
		(at 40 40 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "0fa77ed6-d225-4b65-9517-46b52213ab66")
	)
	(text "36k, 100k and 200k resistors have no verified LCSC code."
		(at 40 43.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "8714e4bf-9715-423b-813b-5e31785e8aef")
	)
	(text "USB_DP and USB_DM are the HOST pair between the ESD device side and the 27 ohm resistors."
		(at 40 47 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "a425e8d9-a478-4e7d-90c3-10edac9fc50f")
	)
	(text "USB D+/D- on the board is 0.290661 mm wide with 0.203200 mm edge gap (DESIGN.md section 13)."
		(at 40 50.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "4e16624a-4768-4076-840d-f999506225d5")
	)
	(text "No level shifter on the SK6812 data pin. Direct 3.3 V drive is not guaranteed."
		(at 40 54 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "36ac20cb-bef8-4759-9b17-e3d0390fe47a")
	)
	(text "Firmware LED cap is 10 percent of full-scale white, both halves together."
		(at 40 57.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "bc754017-6d49-4fce-9a80-9bbbb4e82249")
	)
