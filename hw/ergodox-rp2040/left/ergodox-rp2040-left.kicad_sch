	(text "LEFT half. Silkscreen this board LEFT."
		(at 40 12 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "534c9cdc-dc4f-4c30-86b7-b07864af8a99")
	)
	(text "LINK receptacle silkscreen: LINK and NOT A PC PORT. It is not a USB device port."
		(at 40 15.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "6982c18b-1036-4f38-bf23-0860ff5b820c")
	)
	(text "UART swap on this half: D+ = LINK_TX, D- = LINK_RX. GPIO0 is UART0 TX. GPIO1 is UART0 RX."
		(at 40 19 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "bb4191ad-2408-4bbe-9dd5-7a6011390927")
	)
	(text "Board id: GPIO19 10k to GND. Firmware may read it. It does not select the ZMK role."
		(at 40 22.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "4b6f5fa6-e34f-4a76-bf7b-c69627591cfa")
	)
	(text "ZMK role is compile-time. Flash the central image into the half whose HOST plug is in the computer."
		(at 40 26 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "b9fdfeaf-42a4-4e1e-8a1f-0177bf0d30db")
	)
	(text "HOST CC pins are Rd 5.1k only. No Rp on HOST. VBUS enters +5V through SS14."
		(at 40 29.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "29caffa1-0c58-467a-bfe2-70818d6291ca")
	)
	(text "LINK Rp is 36k to +3.3V, one per CC pin, only while LINK_RP_EN is high."
		(at 40 33 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "a192fa65-8c64-457d-8e68-2882fb190a8f")
	)
	(text "CC divider 200k/100k keeps a 36k open pin at 2.95 V and 5.5 V at 1.83 V on the ADC."
		(at 40 36.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "81cfd5de-0b99-486a-8ce9-0ea385cc54bc")
	)
	(text "VBUS divider 100k/100k maps 5.5 V to 2.75 V. Divider LCSC codes are blank."
		(at 40 40 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "d209a271-3bfe-4028-beaf-1a2482678868")
	)
	(text "JFET, Rp MOSFET, and both gate MOSFETs have no verified MPN or LCSC."
		(at 40 43.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "887ab052-b132-4c87-b754-a7947824da56")
	)
	(text "USB_DP and USB_DM are the HOST pair between the ESD device side and the 27 ohm resistors."
		(at 40 47 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "37cc0abe-c2e7-4cc0-a28e-5517f3423965")
	)
	(text "USB D+/D- on the board is 0.290661 mm wide with 0.203200 mm edge gap (DESIGN.md section 13)."
		(at 40 50.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "0b61620e-8663-4578-b0ea-25a05d9f2a5f")
	)
	(text "No level shifter on the SK6812 data pin. Direct 3.3 V drive is not guaranteed."
		(at 40 54 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "b0943246-9da3-4e15-9445-09e6e7d3ae4e")
	)
	(text "Firmware LED cap is 10 percent of full-scale white, both halves together."
		(at 40 57.5 0)
		(effects
			(font
				(size 1.27 1.27)
				)
		)
		(uuid "f9e863fc-f7d0-479c-80c8-ba0d74007c98")
	)
